{
  "name": "opencode-session-meter",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Generation speed, context usage and prompt cache hit rate in the OpenCode Desktop session header",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tokens",
    "context",
    "cache",
    "desktop"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=browser",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@opencode/plugin": "2.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/bun": "^1.4.5",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "author": "RybakovK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RybakovK/opencode-session-meter.git"
  },
  "homepage": "https://github.com/RybakovK/opencode-session-meter#readme",
  "bugs": {
    "url": "https://github.com/RybakovK/opencode-session-meter/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  }
}
